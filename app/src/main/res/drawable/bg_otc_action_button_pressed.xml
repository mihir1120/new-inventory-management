<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="oval">
      <solid android:color="#E1E4E9" />
    </shape>
  </item>
  <item
    android:left="3dp"
    android:top="3dp"
    android:right="3dp"
    android:bottom="3dp">
    <shape android:shape="oval">
      <gradient
        android:angle="135"
        android:startColor="#D1D5DC"
        android:endColor="#F7F8FA" />
      <stroke
        android:width="1dp"
        android:color="#CDD2D9" />
    </shape>
  </item>
</layer-list>

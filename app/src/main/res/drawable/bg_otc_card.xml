<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#D5DADF" />
      <corners android:radius="28dp" />
    </shape>
  </item>
  <item
    android:left="4dp"
    android:top="4dp"
    android:right="4dp"
    android:bottom="4dp">
    <shape android:shape="rectangle">
      <gradient
        android:angle="315"
        android:startColor="#FBFCFD"
        android:endColor="#E5E8ED" />
      <corners android:radius="24dp" />
      <stroke
        android:width="1dp"
        android:color="#F9FAFB" />
    </shape>
  </item>
</layer-list>

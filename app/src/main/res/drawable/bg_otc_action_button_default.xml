<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="oval">
      <solid android:color="#E6E8EC" />
    </shape>
  </item>
  <item
    android:left="3dp"
    android:top="3dp"
    android:right="3dp"
    android:bottom="3dp">
    <shape android:shape="oval">
      <gradient
        android:angle="315"
        android:startColor="#FFFFFF"
        android:endColor="#D3D8E0" />
      <stroke
        android:width="1dp"
        android:color="#F7F8FA" />
    </shape>
  </item>
</layer-list>

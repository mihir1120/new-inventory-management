<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#D7DBE1" />
      <corners android:radius="32dp" />
    </shape>
  </item>
  <item
    android:left="4dp"
    android:top="4dp"
    android:right="4dp"
    android:bottom="4dp">
    <shape android:shape="rectangle">
      <gradient
        android:angle="315"
        android:startColor="#F6F7F9"
        android:endColor="#E4E7EC" />
      <corners android:radius="28dp" />
      <stroke
        android:width="1dp"
        android:color="#FAFBFC" />
    </shape>
  </item>
</layer-list>

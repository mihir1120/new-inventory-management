<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/otcRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#E6E9EE">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/otcHeader"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:minHeight="186dp"
    android:layout_marginStart="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_otc_header_panel"
    android:clipToPadding="false"
    android:elevation="8dp"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <TextView
      android:id="@+id/otcStatusChip"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/bg_otc_chip"
      android:paddingStart="14dp"
      android:paddingTop="8dp"
      android:paddingEnd="14dp"
      android:paddingBottom="8dp"
      android:text="@string/otc_header_chip"
      android:textColor="#59616B"
      android:textSize="12sp"
      android:textStyle="bold"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <TextView
      android:id="@+id/otcHeadline"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:text="@string/otc_header_title"
      android:textColor="#26303D"
      android:textSize="28sp"
      android:textStyle="bold"
      app:layout_constraintEnd_toStartOf="@+id/otcActionRail"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/otcStatusChip" />

    <TextView
      android:id="@+id/otcSubheadline"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:alpha="0.84"
      android:text="@string/otc_header_body"
      android:textColor="#4F5B68"
      android:textSize="15sp"
      app:layout_constraintEnd_toStartOf="@+id/otcActionRail"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/otcHeadline" />

    <ImageView
      android:id="@+id/otcLogo"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:adjustViewBounds="true"
      android:layout_marginTop="18dp"
      android:contentDescription="@string/otc_logo_content_description"
      android:scaleType="fitStart"
      android:src="@drawable/av_logo_exact"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintDimensionRatio="360:118"
      app:layout_constraintEnd_toStartOf="@+id/otcActionRail"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@id/otcSubheadline"
      app:layout_constraintVertical_bias="0" />

    <LinearLayout
      android:id="@+id/otcActionRail"
      android:layout_width="wrap_content"
      android:layout_height="0dp"
      android:gravity="end"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingTop="10dp"
      android:paddingBottom="10dp"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent">

      <ImageButton
        android:id="@+id/actionBack"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_otc_action_button"
        android:contentDescription="@string/otc_action_back"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:tint="#5F6770"
        android:src="@android:drawable/ic_media_previous" />

      <ImageButton
        android:id="@+id/actionCart"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_otc_action_button"
        android:contentDescription="@string/otc_action_cart"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:tint="#5F6770"
        android:src="@drawable/wheelbarrow" />

      <ImageButton
        android:id="@+id/actionClosed"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_otc_action_button"
        android:contentDescription="@string/otc_action_closed"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:tint="#5F6770"
        android:src="@drawable/icon_closed_list" />
    </LinearLayout>

  </androidx.constraintlayout.widget.ConstraintLayout>

  <androidx.core.widget.NestedScrollView
    android:id="@+id/otcScrollView"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:paddingBottom="24dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/otcHeader">

    <LinearLayout
      android:id="@+id/otcScrollContent"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingTop="16dp"
      android:paddingEnd="16dp"
      android:paddingBottom="24dp" />
  </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
